{"uid":"marketplace-diagnostics","title":"Marketplace - production diagnostics","description":"Phase 6: one panel per diagnostic question (docs/production-diagnostics.md).","tags":["marketplace","phase6"],"timezone":"browser","schemaVersion":41,"version":1,"editable":false,"refresh":"5s","time":{"from":"now-15m","to":"now"},"panels":[
{"id":1,"type":"row","title":"Traffic and latency — is it slow, for how many requests, since when?","collapsed":false,"gridPos":{"x":0,"y":0,"w":24,"h":1},"panels":[]},
{"id":2,"type":"timeseries","title":"Request rate by service","description":"HTTP requests per second, management endpoints excluded.","gridPos":{"x":0,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[$__rate_interval]))","legendFormat":"{{application}}"}]},
{"id":3,"type":"timeseries","title":"marketplace HTTP latency p50 / p95 / p99","description":"histogram_quantile over the http.server.requests histogram buckets. Watch the gap between p50 and p99: averages hide the tail.","gridPos":{"x":8,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval])))","legendFormat":"p50"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval])))","legendFormat":"p95"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval])))","legendFormat":"p99"},{"refId":"D","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(rate(http_server_requests_seconds_sum{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval]))","legendFormat":"mean"}]},
{"id":4,"type":"timeseries","title":"5xx and 4xx rate","description":"Server errors per second by service; 401/403/409 are usually client/business outcomes, 5xx are ours.","gridPos":{"x":16,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval]))","legendFormat":"5xx {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (rate(http_server_requests_seconds_count{status=~\"4..\",uri!~\"/actuator.*\"}[$__rate_interval]))","legendFormat":"4xx {{application}}"}]},
{"id":5,"type":"timeseries","title":"p99 by endpoint (marketplace)","description":"Which URI template is slow? Tags are templates (/api/orders/{id}), never raw ids.","gridPos":{"x":0,"y":9,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"marketplace-service\",uri!~\"/actuator.*\"}[$__rate_interval])))","legendFormat":"{{method}} {{uri}}"}]},
{"id":6,"type":"timeseries","title":"Request threads busy (Tomcat)","description":"Busy request threads vs the pool maximum. All busy + CPU low = threads are waiting (downstream, DB pool, locks).","gridPos":{"x":12,"y":9,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"tomcat_threads_busy_threads","legendFormat":"busy {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"tomcat_threads_config_max_threads","legendFormat":"max {{application}}"}]},
