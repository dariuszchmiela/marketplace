{"id":19,"type":"timeseries","title":"Outbox backlog and lag","description":"Pending rows (left) and age of the oldest pending row in seconds: the outbox lag. Grows during a Kafka outage, drains after recovery.","gridPos":{"x":0,"y":44,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"outbox_pending_count","legendFormat":"pending rows"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"outbox_pending_retrying","legendFormat":"retrying rows"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"outbox_oldest_pending_age_seconds","legendFormat":"oldest pending age (s)"}]},
{"id":20,"type":"timeseries","title":"Outbox publish success / failure","description":"Kafka acknowledgements vs failed sends per second.","gridPos":{"x":8,"y":44,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"ops","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (event_type) (rate(outbox_publish_success_total[$__rate_interval]))","legendFormat":"success {{event_type}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (event_type) (rate(outbox_publish_failure_total[$__rate_interval]))","legendFormat":"failure {{event_type}}"}]},
{"id":21,"type":"timeseries","title":"Kafka consumer lag (order-activity)","description":"Records not yet consumed per partition (Kafka client metric records_lag; the client exports each topic twice, dotted and underscored — filter on the real name). Lag says how far behind, not whether the projection is correct.","gridPos":{"x":16,"y":44,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (partition) (kafka_consumer_fetch_manager_records_lag{application=\"order-activity-service\",topic=\"marketplace.order-events\"})","legendFormat":"lag partition {{partition}}"}]},
{"id":22,"type":"timeseries","title":"Consumer outcomes","description":"processed / duplicate / stale per second — duplicates are normal (at-least-once), stale means replays.","gridPos":{"x":0,"y":52,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"ops","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (eventType) (rate(order_events_processed_total[$__rate_interval]))","legendFormat":"processed {{eventType}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(rate(order_events_duplicate_total[$__rate_interval]))","legendFormat":"duplicate"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(rate(order_events_stale_total[$__rate_interval]))","legendFormat":"stale"}]},
{"id":23,"type":"timeseries","title":"Consumer retries and dead-lettered (DLT)","description":"Retries (transient failures) and events sent to the DLT in the last 5 minutes. DLT > 0 needs a human.","gridPos":{"x":12,"y":52,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(increase(order_events_retry_total[5m]))","legendFormat":"retries (5m)"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (reason) (increase(order_events_dead_lettered_total[5m]))","legendFormat":"dead-lettered {{reason}} (5m)"}]},
