{"id":8,"type":"timeseries","title":"Checkout outcomes","description":"marketplace.checkout.total by bounded result: PAID, PAYMENT_FAILED, PAYMENT_UNKNOWN, STOCK_CONFLICT, REJECTED, REPLAYED, ERROR.","gridPos":{"x":0,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"ops","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (result) (rate(marketplace_checkout_total[$__rate_interval]))","legendFormat":"{{result}}"}]},
{"id":9,"type":"timeseries","title":"Checkout duration p50 / p99 and steps","description":"The whole orchestration vs its steps: two short DB transactions and the payment call (no transaction held).","gridPos":{"x":8,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.50, sum by (le) (rate(marketplace_checkout_duration_seconds_bucket[$__rate_interval])))","legendFormat":"checkout p50"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.99, sum by (le) (rate(marketplace_checkout_duration_seconds_bucket[$__rate_interval])))","legendFormat":"checkout p99"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (step) (rate(marketplace_checkout_step_duration_seconds_sum[$__rate_interval])) / sum by (step) (rate(marketplace_checkout_step_duration_seconds_count[$__rate_interval]))","legendFormat":"step {{step}} (mean)"}]},
{"id":10,"type":"timeseries","title":"Payment client p99 by result + circuit breaker","description":"payment.client.duration per logical call (retries included). Circuit open = fail fast. Right axis: circuit state (1 = open).","gridPos":{"x":16,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.99, sum by (le, result) (rate(payment_client_duration_seconds_bucket[$__rate_interval])))","legendFormat":"p99 {{result}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max(resilience4j_circuitbreaker_state{state=\"open\"})","legendFormat":"circuit open"}]},
