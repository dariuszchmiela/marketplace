{"id":26,"type":"timeseries","title":"Service-to-service / management auth rejections","description":"Callers without a valid service, internal API or management token.","gridPos":{"x":12,"y":61,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"ops","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (reason) (rate(security_service_auth_rejected_total[$__rate_interval]))","legendFormat":"payment service token {{reason}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (reason) (rate(security_internal_api_rejected_total[$__rate_interval]))","legendFormat":"order-activity API {{reason}}"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (rate(security_management_rejected_total[$__rate_interval]))","legendFormat":"management {{application}}"}]}
