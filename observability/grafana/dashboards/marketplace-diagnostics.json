{"id":12,"type":"timeseries","title":"HikariCP connections","description":"active / max / pending. pending > 0 with active = max: the DB pool is the bottleneck (or a transaction is too long).","gridPos":{"x":0,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"hikaricp_connections_active","legendFormat":"active {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"hikaricp_connections_max","legendFormat":"max {{application}}"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"hikaricp_connections_pending","legendFormat":"pending {{application}}"}]},
{"id":13,"type":"timeseries","title":"Connection acquire time (max)","description":"How long threads waited for a DB connection.","gridPos":{"x":8,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"hikaricp_connections_acquire_seconds_max","legendFormat":"{{application}}"}]},
{"id":14,"type":"timeseries","title":"JVM heap used / max","description":"Heap in use. A saw-tooth is normal; a rising floor (heap after GC) is retention.","gridPos":{"x":16,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (jvm_memory_used_bytes{area=\"heap\"})","legendFormat":"used {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (jvm_memory_max_bytes{area=\"heap\"})","legendFormat":"max {{application}}"},{"refId":"C","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (application) (jvm_memory_usage_after_gc{area=\"heap\",pool=\"long-lived\"})","legendFormat":"after GC (old gen) {{application}}"}]},
{"id":15,"type":"timeseries","title":"GC pause time per second / max pause","description":"Time spent in GC pauses per second, and the longest recent pause.","gridPos":{"x":0,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (application) (rate(jvm_gc_pause_seconds_sum[$__rate_interval]))","legendFormat":"pause s/s {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (application) (jvm_gc_pause_seconds_max)","legendFormat":"max pause {{application}}"}]},
{"id":16,"type":"timeseries","title":"Live threads and thread states","description":"Platform threads only (virtual threads are not counted). Many BLOCKED = lock contention.","gridPos":{"x":8,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"jvm_threads_live_threads","legendFormat":"live {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"jvm_threads_states_threads{application=\"marketplace-service\",state=~\"blocked|waiting|timed-waiting\"}","legendFormat":"{{state}} (marketplace)"}]},
{"id":17,"type":"timeseries","title":"CPU usage","description":"process_cpu_usage (this JVM) vs system_cpu_usage (the machine). Slow + CPU low: waiting. Slow + CPU high: computing or GC.","gridPos":{"x":16,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","custom":{"lineWidth":1,"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"process_cpu_usage","legendFormat":"process {{application}}"},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max(system_cpu_usage)","legendFormat":"system"}]},
